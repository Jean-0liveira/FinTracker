<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.NovaTransacaoController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints minWidth="260"/>
        </columnConstraints>
        <Label text="Descrição" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoDescricao" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Valor" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoValor" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Tipo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboTipo" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Data" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="campoData" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar" cancelButton="true"/>
        <Button text="Salvar" onAction="#salvar" defaultButton="true"/>
    </HBox>
</VBox>
