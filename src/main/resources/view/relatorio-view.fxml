<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.RelatorioController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Resumo financeiro" styleClass="titulo"/>
    <GridPane hgap="24" vgap="14" styleClass="cartao">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints minWidth="180"/>
        </columnConstraints>
        <Label text="Total de receitas" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblReceitas" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Total de despesas" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblDespesas" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Saldo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblSaldo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Transações" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="lblQuantidade" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox alignment="CENTER_RIGHT">
        <Button text="Fechar" styleClass="button-primario" onAction="#fechar" defaultButton="true"/>
    </HBox>
</VBox>
