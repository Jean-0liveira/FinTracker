<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.MainController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colData" text="Data" prefWidth="120"/>
            <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="320"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
            <TableColumn fx:id="colValor" text="Valor" prefWidth="180"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button text="Nova transação" onAction="#novaTransacao"/>
        <Button text="Remover selecionada" onAction="#remover"/>
    </HBox>
</VBox>
